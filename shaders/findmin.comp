#version 440

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) buffer Min { float data[NELEMENTS]; }
minima;
layout(push_constant) uniform Stride { uint stride; };

void main() {
  uint i = gl_GlobalInvocationID.x;
  minima.data[i] = min(minima.data[i], minima.data[i + stride]);
}

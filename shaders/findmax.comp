#version 440

layout(constant_id = 0) const uint NELEMENTS = 512;
layout(constant_id = 1) const uint GROUPS = 1;
layout(local_size_x_id = 2, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) buffer Max { float data[NELEMENTS]; }
maxima;
layout(push_constant) uniform Stride { uint stride; };

void main() {
  uint i = gl_GlobalInvocationID.x;
  maxima.data[i] = max(maxima.data[i], maxima.data[i + stride]);
}
